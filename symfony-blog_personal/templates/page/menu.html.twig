{% extends 'base.html.twig' %}
{% block title %}Menu{% endblock %}

{# Como la página de inicio tiene un header diferente al resto
pondremos lo siguiente para que el base detecte quienes lo tienen
y quienes no #}

{% set show_header = true %}
{% set page_title = 'Menu' %}
{% set breadcrumb = 'Home' %}

{% block body %}
<!-- Menu Start -->
<div class="container-fluid pt-5">
    <div class="container">
        <div class="section-title text-center mb-5">
            <h4 class="text-primary text-uppercase" style="letter-spacing: 5px;">Menu & Pricing</h4>
            <h1 class="display-4">Our Delicious Menu</h1>
        </div>

        {% for t in types %}
            <h2 class="mb-4 text-center text-secondary">{{ t.name }}</h2>
            <div class="row">
                {% for m in t.menus %}
                    <div class="col-12 col-sm-6 col-lg-4 mb-5">
                        <div class="d-flex align-items-center">
                            <div class="me-3">
                                <img src="{{ asset('uploads/menus/' ~ m.file) }}" class="rounded-circle" alt="{{ m.name }}" style="width:100px; height:100px; object-fit:cover;">
                                <h5 class="menu-price mt-2 fw-bold text-white" style="background-color:#FF4D95; border-radius:50%; width:50px; height:50px; display:flex; align-items:center; justify-content:center; margin:0 auto;">${{ m.price }}</h5>                            
                                </div>
                            <div>
                                <h4 class="fw-bold">{{ m.name }}</h4>
                                <p class="m-0 text-muted">{{ m.description }}</p>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <p class="text-center">No hay nada aún.</p>
                {% endfor %}
            </div>
            <hr class="my-5">
        {% endfor %}
    </div>
</div>
<!-- Menu End -->
{% endblock %}

